# Local secrets — never commit. `.env.example` documents the required variables.
.env
.env.local
.env.*.local
.env.development
.env.production

# Dependencies and build output
node_modules/
dist/
.vite/
.vite-temp/

# Local tooling caches
.npm-cache/
.pnpm-store/
__pycache__/
*.pyc

